# ──────────────────────────────────────────────────────────────────────────────
# SocietyOS — example environment configuration
# Copy to .env and adjust. NEVER commit the real .env file.
# ──────────────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000

# Comma-separated list of allowed browser origins (admin, resident, guard)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# 64+ char random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars-long

# ── Database ──────────────────────────────────────────────────────────────────
# Development default points at the embedded Postgres instance managed by
# `pnpm db:up` (data stored in .localdata/postgres). For a real server set a
# standard postgresql:// URL here instead.
DATABASE_URL=postgresql://societyos:societyos@127.0.0.1:55432/societyos?schema=public
# Port the embedded dev Postgres listens on
DEV_PG_PORT=55432

# ── Redis / BullMQ (optional) ────────────────────────────────────────────────
# When unset, the queue system falls back to the built-in Postgres-backed dev driver.
# REDIS_URL=redis://127.0.0.1:6379

# ── Object storage ────────────────────────────────────────────────────────────
# STORAGE_DRIVER=local | s3
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.localdata/storage
# S3 / MinIO (production or docker compose dev)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=societyos-files
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
FILE_SIGNED_URL_TTL_SECONDS=600

# ── Auth providers ────────────────────────────────────────────────────────────
# OTP_PROVIDER=mock | sms-adapter   (mock logs OTPs to the API console; never use mock in production)
OTP_PROVIDER=mock
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
EMAIL_PROVIDER=mock

# Access token lifetime in seconds (default 900 = 15 min)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# ── Visitor policy defaults (overridable per community) ──────────────────────
DEFAULT_VISITOR_APPROVAL_TIMEOUT_SECONDS=90

# ── Frontends ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000
