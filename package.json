{
  "name": "societyos",
  "version": "0.1.0",
  "private": true,
  "description": "SocietyOS — multi-tenant Community Management ERP & Gate Security SaaS (original implementation of the MyGate product category).",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev:api": "pnpm --filter @societyos/api dev",
    "dev:admin": "pnpm --filter @societyos/admin-web dev",
    "dev:resident": "pnpm --filter @societyos/resident-pwa dev",
    "dev:guard": "pnpm --filter @societyos/guard-pwa dev",
    "db:up": "pnpm --filter @societyos/api db:up",
    "db:migrate": "pnpm --filter @societyos/api db:migrate",
    "db:seed": "pnpm --filter @societyos/api db:seed",
    "setup": "node scripts/setup-dev.mjs"
  },
  "devDependencies": {
    "eslint": "9.17.0",
    "eslint-plugin-import": "2.31.0",
    "jiti": "2.4.2",
    "turbo": "2.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "8.19.0"
  },
  "pnpm": {
    "packageExtensions": {
      "react@19.0.0": {
        "peerDependencies": { "@types/react": "^19.0.0" }
      },
      "react-dom@19.0.0": {
        "peerDependencies": { "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0" }
      }
    },
    "onlyBuiltDependencies": [
      "@embedded-postgres/windows-x64",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
